# Generated by Cargo (matches nested target dirs too, e.g. the excluded
# nightly crate tpt-t-agri-crop builds its own target/ when run standalone).
/target
target/
**/target
**/target/

# Backup files generated by rustfmt
**/*.rs.bk

# Remove Cargo.lock for libraries, but keep for binaries
# Cargo.lock

# MSVC Windows
*.pdb

# Cargo www cache
~/.cargo/

# Editors / IDEs
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.exe

# Docs
/target/doc/

safe.log

# tpt-weave working state
/.tpt-weave/
